# ==========================================
# CHOOSE YOUR BRAINS
# ==========================================

# Option 1: OpenRouter (RECOMMENDED - one key, 200+ models)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Option 2: OpenAI Direct (for Codex)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Option 3: Ollama (FREE - runs on your Mac)
# Install: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=codestral

# ==========================================
# AGENT CONFIG
# ==========================================
AGENT_NAME=alpha
MEMORY_DB_PATH=./memory/agent_memory.db
SKILLS_DIR=./skills

# HITL: true = pause for approval, false = run autonomously
HITL_ENABLED=true

# Budget protection (dollars per day)
DAILY_BUDGET_CLAUDE=10.0
DAILY_BUDGET_CODEX=5.0
DAILY_BUDGET_TOTAL=20.0

# ==========================================
# TELEGRAM NOTIFICATIONS (Step 3)
# ==========================================
# 1. Message @BotFather on Telegram
# 2. Type /newbot
# 3. Copy the API token here
# 4. Message @userinfobot to get your chat ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
